  fn removeEntityAt:void (x:int y:int) {
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def kept:[MapEntity]
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.x == x) {
        if (e.y == y) {
          i = i + 1
          continue
        }
      }
      push kept e
      i = i + 1
    }
    floor.entities = kept
  }

  fn isConsumableItemEntity:boolean (e:MapEntity) {
    if ((strlen e.id) < 1) {
      return false
    }
    if (e.kind != "item") {
      return false
    }
    if ((strlen e.itemTool) > 0) {
      return false
    }
    def id:string e.id
    if ((strlen id) >= 18) {
      def coffeeTag:string (substring id 7 18)
      if (coffeeTag == "emoji-coffee") {
        return true
      }
    }
    if ((strlen id) >= 17) {
      def lunchTag:string (substring id 7 17)
      if (lunchTag == "emoji-lunch") {
        return true
      }
    }
    def ch:string e.char
    if (ch == "☕") {
      return true
    }
    if (ch == "🍱") {
      return true
    }
    return false
  }

  fn consumeItemAt:boolean (x:int y:int) {
    def e:MapEntity (this.entityAt(x y))
    if (this.isConsumableItemEntity(e) == false) {
      return false
    }
    this.removeEntityAt(x y)
    return true
  }

  fn pickupItemAt:string (x:int y:int) {
    def e:MapEntity (this.entityAt(x y))
    if ((strlen e.id) < 1) {
      return ""
    }
    if (e.kind != "item") {
      return ""
    }
    if ((strlen e.itemTool) < 1) {
      return ""
    }
    def pick:string e.itemTool
    lastPickedOwner = e.itemOwner
    this.removeEntityAt(x y)
    this.setTileAt(x y ".")
    return pick
  }

  fn hasDroppedCardFrom:boolean (coworkerId:string) {
    def i:int 0
    def n:int (array_length droppedCardOwners)
    while (i < n) {
      if ((at droppedCardOwners i) == coworkerId) {
        return true
      }
      i = i + 1
    }
    return false
  }

  fn markDroppedCardFrom:void (coworkerId:string) {
    if (this.hasDroppedCardFrom(coworkerId)) {
      return
    }
    push droppedCardOwners coworkerId
  }

  fn tryCoworkerDropCard:boolean (coworker:MapEntity) {
    if (coworker.kind != "coworker") {
      return false
    }
    if (this.hasDroppedCardFrom(coworker.id)) {
      return false
    }
    def roll:int (random 0 24)
    if (roll != 0) {
      return false
    }
    def dirs:[int]
    push dirs 1
    push dirs -1
    push dirs 0
    push dirs 0
    def dy:[int]
    push dy 0
    push dy 0
    push dy 1
    push dy -1
    def di:int 0
    while (di < 4) {
      def nx:int (coworker.x + (at dirs di))
      def ny:int (coworker.y + (at dy di))
      def tile:string (this.tileAt(nx ny))
      if (this.isBlockedTile(tile)) {
        di = di + 1
        continue
      }
      def other:MapEntity (this.entityAt(nx ny))
      if ((strlen other.id) > 0) {
        di = di + 1
        continue
      }
      def floor:MapFloor (this.activeFloor())
      def item:MapEntity (new MapEntity)
      item.id = ("dropped-card-" + coworker.id)
      item.char = "k"
      item.name = "Kulkukortti"
      item.kind = "item"
      item.itemTool = "coworker_card"
      item.itemOwner = coworker.id
      item.x = nx
      item.y = ny
      def ents:[MapEntity] (floor.entities)
      push ents item
      floor.entities = ents
      this.markDroppedCardFrom(coworker.id)
      overheardMsg = (coworker.name + " pudotti jotain lattialle!")
      return true
    }
    return false
  }

  fn openTileAt:void (x:int y:int) {
    def tile:string (this.tileAt(x y))
    if (tile == "L") {
      this.setTileAt(x y ".")
      return
    }
    if (tile == "+") {
      this.setTileAt(x y ".")
      return
    }
    if (tile == "%") {
      this.setTileAt(x y ".")
    }
  }

  fn recordBreakEvent:void (x:int y:int tile:string severity:string timeMinutes:int) {
    def evt:WorldEvent (new WorldEvent)
    evt.floor = currentFloor
    evt.x = x
    evt.y = y
    evt.timeMinutes = timeMinutes
    evt.playerSource = true
    if (tile == "L") {
      evt.applyDoorBroken()
    } {
      if (tile == "+") {
        evt.applyDoorBroken()
      } {
        if (severity == "heavy") {
          evt.applyWallBrokenHeavy()
        } {
          if (severity == "medium") {
            evt.applyWallBrokenMedium()
          } {
            evt.applyWallBrokenLight()
          }
        }
      }
    }
    eventLog.push(evt)
  }

  fn pushWorldEvent:void (evt:WorldEvent) {
    eventLog.push(evt)
  }

  fn tryBreakAt:string (x:int y:int tool:string timeMinutes:int) {
    if ((strlen tool) < 1) {
      lastStatus = "Ei valittua työkalua (t vaihtaa)."
      return ""
    }
    def tile:string (this.tileAt(x y))
    if (this.isBreakableTile(tile tool) == false) {
      lastStatus = "Työkalu ei tepsi tähän esteeseen."
      return ""
    }
    lastBrokenTile = tile
    if (tile == "#") {
      if (this.isOuterWallCell(currentFloor x y)) {
        this.recordOuterWallBreach(x y)
      }
    }
    this.setTileAt(x y ".")
    def severity:string ""
    if (tool == "sledgehammer") {
      lastStatus = "Moukarivasara murskaa seinän — melu kantautuu!"
      severity = "heavy"
    } {
      if (tool == "crowbar") {
        lastStatus = "Sorkkarauta taivuttaa esteen."
        severity = "medium"
      } {
        lastStatus = "Lapio avaa raon hiljaa."
        severity = "light"
      }
    }
    if (timeMinutes >= 0) {
      this.recordBreakEvent(x y tile severity timeMinutes)
    }
    return severity
  }

  fn tryBreakFacing:string (tool:string timeMinutes:int) {
    def fx:int facingX
    def fy:int facingY
    if (fx == 0) {
      if (fy == 0) {
        fy = 1
      }
    }
    def tx:int (playerX + fx)
    def ty:int (playerY + fy)
    return (this.tryBreakAt(tx ty tool timeMinutes))
  }

  fn hasRecentLoudEventNear:boolean (radius:int nowMinutes:int maxAge:int minNoise:int) {
    def i:int 0
    def n:int (eventLog.count())
    while (i < n) {
      def evt:WorldEvent (eventLog.at(i))
      if (evt.floor == currentFloor) {
        if (evt.noise >= minNoise) {
          def age:int (nowMinutes - evt.timeMinutes)
          if (age >= 0) {
            if (age <= maxAge) {
              def dx:int (evt.x - playerX)
              if (dx < 0) {
                dx = (0 - dx)
              }
              def dy:int (evt.y - playerY)
              if (dy < 0) {
                dy = (0 - dy)
              }
              if ((dx + dy) <= radius) {
                return true
              }
            }
          }
        }
      }
      i = i + 1
    }
    return false
  }

  fn hasNearbyWitness:boolean (radius:int nowMinutes:int) {
    if (playerWasWitnessed) {
      return true
    }
    if (this.hasRecentLoudEventNear(radius nowMinutes 3 12)) {
      return true
    }
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.offDuty == false) {
        if (e.kind == "coworker") {
          def dx:int (e.x - playerX)
          if (dx < 0) {
            dx = (0 - dx)
          }
          def dy:int (e.y - playerY)
          if (dy < 0) {
            dy = (0 - dy)
          }
          if ((dx + dy) > 0) {
            if ((dx + dy) <= radius) {
              return true
            }
          }
        }
        if (e.kind == "role") {
          def dx2:int (e.x - playerX)
          if (dx2 < 0) {
            dx2 = (0 - dx2)
          }
          def dy2:int (e.y - playerY)
          if (dy2 < 0) {
            dy2 = (0 - dy2)
          }
          if ((dx2 + dy2) > 0) {
            if ((dx2 + dy2) <= radius) {
              return true
            }
          }
        }
        if (e.kind == "security") {
          def dx3:int (e.x - playerX)
          if (dx3 < 0) {
            dx3 = (0 - dx3)
          }
          def dy3:int (e.y - playerY)
          if (dy3 < 0) {
            dy3 = (0 - dy3)
          }
          if ((dx3 + dy3) > 0) {
            if ((dx3 + dy3) <= radius) {
              return true
            }
          }
        }
        if (e.kind == "guru") {
          def dx4:int (e.x - playerX)
          if (dx4 < 0) {
            dx4 = (0 - dx4)
          }
          def dy4:int (e.y - playerY)
          if (dy4 < 0) {
            dy4 = (0 - dy4)
          }
          if ((dx4 + dy4) > 0) {
            if ((dx4 + dy4) <= radius) {
              return true
            }
          }
        }
      }
      i = i + 1
    }
    return false
  }

  fn tryToggleHide:boolean () {
    if (playerHidden) {
      playerHidden = false
      lastStatus = "Nouset esiin."
      return true
    }
    def tile:string (this.tileAt(playerX playerY))
    if (tile == "=") {
      playerHidden = true
      lastStatus = "Piiloudut kopin taakse."
      return true
    }
    return false
  }

  fn canNpcSeePlayer:boolean (e:MapEntity) {
    if (playerHidden == false) {
      return true
    }
    if (e.persistence >= 90) {
      return true
    }
    return false
  }

  fn hasLineOfSight:boolean (x0:int y0:int x1:int y1:int) {
    if (x0 == x1) {
      if (y0 == y1) {
        return true
      }
    }
    def x:int x0
    def y:int y0
    def dx:int (x1 - x0)
    def adx:int dx
    if (adx < 0) {
      adx = (0 - adx)
    }
    def dy:int (y1 - y0)
    def ady:int dy
    if (ady < 0) {
      ady = (0 - ady)
    }
    def sx:int 1
    if (x0 > x1) {
      sx = -1
    }
    def sy:int 1
    if (y0 > y1) {
      sy = -1
    }
    def err:int (adx - ady)
    def done:boolean false
    while (done == false) {
      def atStart:boolean false
      if (x == x0) {
        if (y == y0) {
          atStart = true
        }
      }
      def atEnd:boolean false
      if (x == x1) {
        if (y == y1) {
          atEnd = true
        }
      }
      if (atStart == false) {
        if (atEnd) {
          return true
        }
        def ch:string (this.tileAt(x y))
        if (this.isBlockedTile(ch)) {
          return false
        }
      }
      if (atEnd) {
        return true
      }
      def e2:int (2 * err)
      if (e2 > (0 - ady)) {
        err = (err - ady)
        x = (x + sx)
      }
      if (e2 < adx) {
        err = (err + adx)
        y = (y + sy)
      }
    }
    return false
  }

  fn isActiveAgent:boolean (e:MapEntity) {
    if (e.isAgent == false) {
      return false
    }
    if (e.kind == "item") {
      return false
    }
    if ((strlen e.id) < 1) {
      return false
    }
    return true
  }

  fn entityBlocksPlayer:boolean (e:MapEntity) {
    if ((strlen e.id) < 1) {
      return false
    }
    if (e.kind == "item") {
      return false
    }
    if (e.offDuty) {
      return false
    }
    return true
  }

  fn stepTowardPlayer:void (e:MapEntity) {
    this.stepBestToward(e playerX playerY)
  }

  fn manhattanTo:int (x:int y:int tx:int ty:int) {
    def dx:int (x - tx)
    if (dx < 0) {
      dx = (0 - dx)
    }
    def dy:int (y - ty)
    if (dy < 0) {
      dy = (0 - dy)
    }
    return (dx + dy)
  }

  fn canEntityStepTo:boolean (e:MapEntity nx:int ny:int allowLeavingPeers:boolean) {
    if (nx < 0) {
      return false
    }
    if (ny < 0) {
      return false
    }
    if (nx >= width) {
      return false
    }
    if (ny >= height) {
      return false
    }
    def tile:string (this.tileAt(nx ny))
    if (this.isBlockedTile(tile)) {
      return false
    }
    def other:MapEntity (this.entityAt(nx ny))
    if ((strlen other.id) > 0) {
      if (other.kind != "item") {
        if (other.id != e.id) {
          if (allowLeavingPeers) {
            if (other.npcState != "leaving") {
              if (other.npcState != "at_elevator") {
                return false
              }
            }
          } {
            return false
          }
        }
      }
    }
    return true
  }

  fn cellIndex:int (x:int y:int) {
    return ((y * width) + x)
  }

  fn indexX:int (idx:int) {
    def row:int (to_int (idx / width))
    return (idx - (row * width))
  }

  fn indexY:int (idx:int) {
    return (to_int (idx / width))
  }

  fn isDiscovered:boolean (cells:[int] idx:int) {
    def i:int 0
    def n:int (array_length cells)
    while (i < n) {
      if ((at cells i) == idx) {
        return true
      }
      i = i + 1
    }
    return false
  }

  fn parentOfCell:int (cells:[int] parents:[int] idx:int) {
    def i:int 0
    def n:int (array_length cells)
    while (i < n) {
      if ((at cells i) == idx) {
        return (at parents i)
      }
      i = i + 1
    }
    return -1
  }

  fn tryBfsStep:boolean (e:MapEntity tx:int ty:int allowLeavingPeers:boolean) {
    def startIdx:int (this.cellIndex(e.x e.y))
    def goalIdx:int (this.cellIndex(tx ty))
    if (startIdx == goalIdx) {
      return false
    }
    def queue:[int]
    def discCells:[int]
    def discParent:[int]
    push queue startIdx
    push discCells startIdx
    push discParent (-1)
    def head:int 0
    def found:boolean false
    while (head < (array_length queue)) {
      def cur:int (at queue head)
      head = head + 1
      if (cur == goalIdx) {
        found = true
        break
      }
      def cx:int (this.indexX(cur))
      def cy:int (this.indexY(cur))
      def dir:int 0
      while (dir < 4) {
        def tdx:int 0
        def tdy:int 0
        if (dir == 0) {
          tdx = 0
          tdy = -1
        }
        if (dir == 1) {
          tdx = 0
          tdy = 1
        }
        if (dir == 2) {
          tdx = -1
          tdy = 0
        }
        if (dir == 3) {
          tdx = 1
          tdy = 0
        }
        def nx:int (cx + tdx)
        def ny:int (cy + tdy)
        if (this.canEntityStepTo(e nx ny allowLeavingPeers)) {
          def ni:int (this.cellIndex(nx ny))
          if (this.isDiscovered(discCells ni) == false) {
            push queue ni
            push discCells ni
            push discParent cur
          }
        }
        dir = dir + 1
      }
    }
    if (found == false) {
      return false
    }
    def walk:int goalIdx
    def prev:int (this.parentOfCell(discCells discParent walk))
    while (prev != startIdx) {
      if (prev < 0) {
        return false
      }
      walk = prev
      prev = (this.parentOfCell(discCells discParent walk))
    }
    def sx:int (this.indexX(walk))
    def sy:int (this.indexY(walk))
    navStepDx = (sx - e.x)
    navStepDy = (sy - e.y)
    return true
  }

  fn stepBestToward:void (e:MapEntity tx:int ty:int) {
    if (e.x == tx) {
      if (e.y == ty) {
        return
      }
    }
    def allowPeers:boolean false
    if (e.npcState == "leaving") {
      allowPeers = true
    }
    if (this.tryBfsStep(e tx ty allowPeers)) {
      if (this.canEntityStepTo(e (e.x + navStepDx) (e.y + navStepDy) allowPeers)) {
        this.tryMoveEntity(e navStepDx navStepDy)
        return
      }
    }
    def ex:int e.x
    def ey:int e.y
    def curDist:int (this.manhattanTo(ex ey tx ty))
    def pdx:int 0
    def pdy:int 0
    if (ex < tx) {
      pdx = 1
    }
    if (ex > tx) {
      pdx = -1
    }
    if (pdx == 0) {
      if (ey < ty) {
        pdy = 1
      }
      if (ey > ty) {
        pdy = -1
      }
    }
    if (pdx != 0) {
      if (pdy != 0) {
        def pick:int (random 0 1)
        if (pick == 0) {
          pdy = 0
        }
        if (pick == 1) {
          pdx = 0
        }
      }
    }
    if (pdx != 0) {
      if (this.canEntityStepTo(e (ex + pdx) (ey + pdy) allowPeers)) {
        def nd:int (this.manhattanTo((ex + pdx) (ey + pdy) tx ty))
        if (nd < curDist) {
          this.tryMoveEntity(e pdx pdy)
          return
        }
      }
    }
    if (pdy != 0) {
      if (this.canEntityStepTo(e (ex + pdx) (ey + pdy) allowPeers)) {
        def nd2:int (this.manhattanTo((ex + pdx) (ey + pdy) tx ty))
        if (nd2 < curDist) {
          this.tryMoveEntity(e pdx pdy)
          return
        }
      }
    }
    def bestDx:int 0
    def bestDy:int 0
    def bestDist:int curDist
    def found:boolean false
    def dir:int 0
    while (dir < 4) {
      def tdx:int 0
      def tdy:int 0
      if (dir == 0) {
        tdx = 0
        tdy = -1
      }
      if (dir == 1) {
        tdx = 0
        tdy = 1
      }
      if (dir == 2) {
        tdx = -1
        tdy = 0
      }
      if (dir == 3) {
        tdx = 1
        tdy = 0
      }
      def nx:int (ex + tdx)
      def ny:int (ey + tdy)
      if (this.canEntityStepTo(e nx ny allowPeers)) {
        def d:int (this.manhattanTo(nx ny tx ty))
        if (d < bestDist) {
          bestDist = d
          bestDx = tdx
          bestDy = tdy
          found = true
        }
      }
      dir = dir + 1
    }
    if (found) {
      this.tryMoveEntity(e bestDx bestDy)
      return
    }
    dir = 0
    while (dir < 4) {
      def tdx2:int 0
      def tdy2:int 0
      if (dir == 0) {
        tdx2 = 0
        tdy2 = -1
      }
      if (dir == 1) {
        tdx2 = 0
        tdy2 = 1
      }
      if (dir == 2) {
        tdx2 = -1
        tdy2 = 0
      }
      if (dir == 3) {
        tdx2 = 1
        tdy2 = 0
      }
      def nx2:int (ex + tdx2)
      def ny2:int (ey + tdy2)
      if (this.canEntityStepTo(e nx2 ny2 allowPeers)) {
        this.tryMoveEntity(e tdx2 tdy2)
        return
      }
      dir = dir + 1
    }
  }

  fn stepWander:void (e:MapEntity) {
    def roll:int (random 0 3)
    def dx:int 0
    def dy:int 0
    if (roll == 0) {
      dx = 1
    }
    if (roll == 1) {
      dx = -1
    }
    if (roll == 2) {
      dy = 1
    }
    if (roll == 3) {
      dy = -1
    }
    this.tryMoveEntity(e dx dy)
  }

  fn tryMoveEntity:void (e:MapEntity dx:int dy:int) {
    def nx:int (e.x + dx)
    def ny:int (e.y + dy)
    def tile:string (this.tileAt(nx ny))
    if (this.isBlockedTile(tile)) {
      return
    }
    def other:MapEntity (this.entityAt(nx ny))
    if ((strlen other.id) > 0) {
      if (other.kind != "item") {
        return
      }
    }
    e.x = nx
    e.y = ny
  }

  fn teleportToPrison:void () {
    def floor:MapFloor (this.activeFloor())
    def rows:[string] (floor.rows)
    def y:int 0
    def h:int (array_length rows)
    while (y < h) {
      def row:string (at rows y)
      def x:int 0
      def w:int (strlen row)
      while (x < w) {
        def ch:string (substring row x (x + 1))
        if (ch == "J") {
          playerX = x
          playerY = y
          lastStatus = "Turvallisuus vangitsi sinut."
          return
        }
        x = x + 1
      }
      y = y + 1
    }
    playerX = floor.spawnX
    playerY = floor.spawnY
    lastStatus = "Turvallisuus vangitsi sinut."
  }

  fn bumpAtPlayer:MapEntity () {
    if (playerHidden) {
      return (new MapEntity)
    }
    def e:MapEntity (this.entityAt(playerX playerY))
    if (this.entityBlocksPlayer(e)) {
      return e
    }
    return (new MapEntity)
  }

  fn emitAmbient:void (e:MapEntity line:string) {
    overheardMsg = (e.name + ": \"" + line + "\"")
    lastStatus = ""
  }

  fn tryAgentAmbient:void (e:MapEntity) {
    if (e.agentGoal != "seek_larry") {
      return
    }
    if (playerHidden == false) {
      return
    }
    def distSq:int ((e.x - playerX) * (e.x - playerX) + (e.y - playerY) * (e.y - playerY))
    if (distSq > 36) {
      return
    }
    def roll:int (random 0 2)
    if (roll == 0) {
      this.emitAmbient(e ("Oletko nähnyt " + playerAlias + "?"))
    }
    if (roll == 1) {
      this.emitAmbient(e ("Missä " + playerAlias + " on?"))
    }
  }

  fn stepTowardTile:void (e:MapEntity tx:int ty:int) {
    this.stepBestToward(e tx ty)
  }

  fn pickLeaveTargetFor:void (e:MapEntity floorIndex:int) {
    leaveTargetX = foundElevatorX
    leaveTargetY = foundElevatorY
    if (this.findElevatorAt(floorIndex) == false) {
      return
    }
    def slot:int (e.homeX + e.homeY + (strlen e.id))
    def off:int 0
    while (off < 8) {
      def oidx:int ((slot + off) % 8)
      def ox:int 0
      def oy:int 0
      if (oidx == 0) {
        ox = -1
        oy = 0
      }
      if (oidx == 1) {
        ox = 1
        oy = 0
      }
      if (oidx == 2) {
        ox = 0
        oy = -1
      }
      if (oidx == 3) {
        ox = 0
        oy = 1
      }
      if (oidx == 4) {
        ox = -1
        oy = -1
      }
      if (oidx == 5) {
        ox = 1
        oy = -1
      }
      if (oidx == 6) {
        ox = -1
        oy = 1
      }
      if (oidx == 7) {
        ox = 1
        oy = 1
      }
      def tx:int (foundElevatorX + ox)
      def ty:int (foundElevatorY + oy)
      if (this.canEntityStepTo(e tx ty true)) {
        leaveTargetX = tx
        leaveTargetY = ty
        return
      }
      off = off + 1
    }
  }

  fn leaveStaggerStart:int (e:MapEntity) {
    def seed:int (e.homeX + (e.homeY * 3) + (strlen e.id))
    return (900 + (seed % 25))
  }

  fn scheduleMoveStride:boolean (e:MapEntity gameMinutes:int) {
    def seed:int (e.homeX + (e.homeY * 3) + (strlen e.id))
    if (e.npcState == "leaving") {
      def phase:int (seed % 6)
      def tick:int (gameMinutes % 6)
      if (phase == tick) {
        return true
      }
      return false
    }
    def phase2:int (seed % 4)
    def tick2:int (gameMinutes % 4)
    if (phase2 == tick2) {
      return true
    }
    return false
  }

  fn retireEntitySeek:void (entityId:string) {
    def fi:int 0
    def fc:int (array_length floors)
    while (fi < fc) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def i:int 0
      def n:int (array_length ents)
      while (i < n) {
        def ent:MapEntity (at ents i)
        if (ent.id == entityId) {
          ent.moveMode = "stationary"
          ent.agentGoal = ""
          return
        }
        i = i + 1
      }
      fi = fi + 1
    }
  }

  fn activateEntitySeek:void (entityId:string goal:string) {
    def fi:int 0
    def fc:int (array_length floors)
    while (fi < fc) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def i:int 0
      def n:int (array_length ents)
      while (i < n) {
        def ent:MapEntity (at ents i)
        if (ent.id == entityId) {
          ent.offDuty = false
          ent.isAgent = true
          ent.moveMode = "seek_player"
          if ((strlen goal) > 0) {
            ent.agentGoal = goal
          }
          return
        }
        i = i + 1
      }
      fi = fi + 1
    }
  }

  fn applyEntitySchedule:void (floorIndex:int floor:MapFloor e:MapEntity gameMinutes:int) {
    if ((strlen e.scheduleRole) < 1) {
      return
    }
    if ((strlen e.activeBehavior) > 0) {
      return
    }
    if (e.scheduleRole == "janitor") {
      return
    }
    if (gameMinutes < 480) {
      e.offDuty = true
      return
    }
    if (gameMinutes >= 1020) {
      e.offDuty = true
      e.npcState = "gone"
      return
    }
    if (e.scheduleRole == "ceo_lunch") {
      if (gameMinutes >= 660) {
        if (gameMinutes < 780) {
          e.offDuty = false
          e.npcState = "lunch_out"
          if (floor.doorX >= 0) {
            this.stepTowardTile(e floor.doorX floor.doorY)
          }
          return
        }
      }
      e.offDuty = true
      return
    }
    if (e.scheduleRole == "ceo") {
      if (gameMinutes >= 660) {
        if (gameMinutes < 780) {
          e.offDuty = true
          e.npcState = "lunch_out"
          return
        }
      }
    }
    if (e.scheduleRole == "mentor") {
      e.offDuty = false
      e.npcState = "desk"
      this.stepTowardTile(e e.homeX e.homeY)
      return
    }
    e.offDuty = false
    def tx:int e.homeX
    def ty:int e.homeY
    if (e.homeX < 1) {
      tx = e.x
      ty = e.y
    }
    e.npcState = "desk"
    if (gameMinutes >= 660) {
      if (gameMinutes < 780) {
        if (e.scheduleRole == "desk_lunch") {
          e.npcState = "desk_lunch"
        }
        if (e.scheduleRole != "desk_lunch") {
          if (floor.cafeteriaX >= 0) {
            def slot:int ((e.homeX + e.homeY) % 5)
            tx = floor.cafeteriaX + slot - 2
            ty = floor.cafeteriaY + (slot % 2)
            e.npcState = "lunch"
          }
        }
      }
    }
    if (gameMinutes >= 900) {
      if (gameMinutes < 1020) {
        def startLeave:int (this.leaveStaggerStart(e))
        if (gameMinutes >= startLeave) {
          if (this.findElevatorAt(floorIndex)) {
            this.pickLeaveTargetFor(e floorIndex)
            tx = leaveTargetX
            ty = leaveTargetY
            e.npcState = "leaving"
            e.offDuty = false
            def distElev:int (this.manhattanTo(e.x e.y foundElevatorX foundElevatorY))
            if (distElev <= 1) {
              if (gameMinutes >= (startLeave + 8)) {
                e.offDuty = true
                e.npcState = "at_elevator"
                return
              }
            }
          }
        }
      }
    }
    if (e.mainTask == "toilet") {
      if (floor.wcX >= 0) {
        e.npcState = "toilet"
        tx = floor.wcX
        ty = floor.wcY
        if (e.x == floor.wcX) {
          if (e.y == floor.wcY) {
            return
          }
        }
      } {
        e.mainTask = "working"
      }
    }
    if (this.scheduleMoveStride(e gameMinutes) == false) {
      return
    }
    this.stepTowardTile(e tx ty)
  }

  fn tickSchedules:void (gameMinutes:int) {
    def savedFloor:int currentFloor
    def fi:int 0
    def fc:int (array_length floors)
    while (fi < fc) {
      currentFloor = fi
      this.recomputeSize()
      def floor:MapFloor (this.activeFloor())
      def ents:[MapEntity] (floor.entities)
      def i:int 0
      def n:int (array_length ents)
      while (i < n) {
        def e:MapEntity (at ents i)
        if (this.isActiveAgent(e)) {
          this.applyEntitySchedule(fi floor e gameMinutes)
        }
        i = i + 1
      }
      fi = fi + 1
    }
    currentFloor = savedFloor
    this.recomputeSize()
  }

  fn stepAwayFromPlayer:void (e:MapEntity) {
    def bestDx:int 0
    def bestDy:int 0
    def bestDist:int -1
    def tryDx:[int]
    def tryDy:[int]
    push tryDx 1
    push tryDy 0
    push tryDx -1
    push tryDy 0
    push tryDx 0
    push tryDy 1
    push tryDx 0
    push tryDy -1
    def di:int 0
    while (di < 4) {
      def dx:int (at tryDx di)
      def dy:int (at tryDy di)
      def nx:int (e.x + dx)
      def ny:int (e.y + dy)
      if (this.canEntityStepTo(e nx ny false)) {
        def nd:int (this.manhattanTo(nx ny playerX playerY))
        if (nd > bestDist) {
          bestDist = nd
          bestDx = dx
          bestDy = dy
        }
      }
      di = di + 1
    }
    if (bestDist >= 0) {
      this.tryMoveEntity(e bestDx bestDy)
    }
  }

  fn stepFollowPlayer:void (e:MapEntity) {
    if (this.canNpcSeePlayer(e) == false) {
      return
    }
    def targetDist:int e.behaviorParam
    if (targetDist < 3) {
      targetDist = 3
    }
    if (targetDist > 5) {
      targetDist = 5
    }
    def dist:int (this.manhattanTo(e.x e.y playerX playerY))
    if (dist < targetDist) {
      this.stepAwayFromPlayer(e)
    } {
      if (dist > targetDist) {
        this.stepBestToward(e playerX playerY)
      }
    }
  }

  fn tickAgents:MapEntity () {
    def empty:MapEntity (new MapEntity)
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def i:int 0
    def n:int (array_length ents)
    def approach:MapEntity empty
    while (i < n) {
      def e:MapEntity (at ents i)
      if (this.isActiveAgent(e) == false) {
        i = i + 1
        continue
      }
      if (e.offDuty) {
        if (e.kind != "police") {
          i = i + 1
          continue
        }
      }
      this.tryAgentAmbient(e)
      if (e.kind == "police") {
        if (policeChaseActive == false) {
          i = i + 1
          continue
        }
        if (playerHidden == false) {
          this.stepTowardPlayer(e)
          if (e.x == playerX) {
            if (e.y == playerY) {
              return e
            }
          }
        }
        i = i + 1
        continue
      }
      if (e.kind == "security") {
        if (agentHuntFlag == false) {
          i = i + 1
          continue
        }
        if (this.canNpcSeePlayer(e)) {
          this.stepTowardPlayer(e)
          if (e.x == playerX) {
            if (e.y == playerY) {
              return e
            }
          }
        }
        i = i + 1
        continue
      }
      if (e.moveMode == "schedule") {
        i = i + 1
        continue
      }
      if (e.moveMode == "stationary") {
        i = i + 1
        continue
      }
      if (e.moveMode == "follow_player") {
        if (this.canNpcSeePlayer(e)) {
          this.stepFollowPlayer(e)
        }
        i = i + 1
        continue
      }
      if (e.moveMode == "seek_player") {
        if (this.canNpcSeePlayer(e)) {
          this.stepBestToward(e playerX playerY)
        }
      }
      if (e.moveMode == "wander") {
        def wanderRoll:int (random 0 2)
        if (wanderRoll == 0) {
          this.stepWander(e)
        }
        if (e.kind == "coworker") {
          this.tryCoworkerDropCard(e)
        }
      }
      if (e.moveMode == "patrol") {
        def patrolRoll:int (random 0 3)
        if (patrolRoll == 0) {
          this.stepWander(e)
        }
      }
      def dx:int (e.x - playerX)
      if (dx < 0) {
        dx = (0 - dx)
      }
      def dy:int (e.y - playerY)
      if (dy < 0) {
        dy = (0 - dy)
      }
      def manhattan:int (dx + dy)
      if (manhattan <= 1) {
        if (this.canNpcSeePlayer(e)) {
          if (e.agentGoal == "welcome_hr") {
            approach = e
          }
          if (e.sociability >= 70) {
            if ((strlen e.storyId) > 0) {
              approach = e
            }
            if (e.agentGoal == "socialize") {
              approach = e
            }
          }
        }
      }
      i = i + 1
    }
    if ((strlen approach.id) > 0) {
      return approach
    }
    return empty
  }

  fn roleDisplayChar:string (ent:MapEntity) {
    if ((strlen ent.id) < 1) {
      return "?"
    }
    if (ent.kind == "action") {
      return ent.char
    }
    if (ent.kind == "item") {
      return ent.char
    }
    if (ent.kind == "coworker") {
      return "t"
    }
    if (ent.kind == "guru") {
      return "g"
    }
    if (ent.kind == "pet") {
      return ent.char
    }
    if (ent.kind == "security") {
      if (ent.char != "!") {
        return ent.char
      }
      return "u"
    }
    if (ent.kind == "police") {
      return ent.char
    }
    if (ent.kind == "hostile") {
      return ent.char
    }
    if (ent.kind == "role") {
      if (ent.id == "receptionist") {
        return "v"
      }
      if (ent.char == "C") {
        return "T"
      }
      if (ent.char == "S") {
        return "s"
      }
      if (ent.char == "P") {
        return "p"
      }
      if (ent.char == "u") {
        return "k"
      }
      return ent.char
    }
    return ent.char
  }

  fn renderChar:string (x:int y:int) {
    if (x == playerX) {
      if (y == playerY) {
        if (playerHidden) {
          return (this.tileAt(x y))
        }
        return "@"
      }
    }
    def e:MapEntity (this.entityAt(x y))
    if ((strlen e.id) > 0) {
      if (e.offDuty) {
        return (this.tileAt(x y))
      }
      return (this.roleDisplayChar(e))
    }
    return (this.tileAt(x y))
  }

  fn findEntityById:MapEntity (entityId:string) {
    def blank:MapEntity (new MapEntity)
    if ((strlen entityId) < 1) {
      return blank
    }
    def fi:int 0
    def fn:int (array_length floors)
    while (fi < fn) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def ei:int 0
      def en:int (array_length ents)
      while (ei < en) {
        def e:MapEntity (at ents ei)
        if (e.id == entityId) {
          return e
        }
        ei = ei + 1
      }
      fi = fi + 1
    }
    return blank
  }

  fn tickNpcMainTasks:void (gameMinutes:int) {
    def fi:int 0
    def fn:int (array_length floors)
    while (fi < fn) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def ei:int 0
      def en:int (array_length ents)
      while (ei < en) {
        def e:MapEntity (at ents ei)
        if ((strlen e.scheduleRole) > 0) {
          if (e.npcState == "lunch") {
            e.mainTask = "eating"
          } {
            if (e.npcState == "desk_lunch") {
              e.mainTask = "eating"
            } {
              if (e.npcState == "lunch_out") {
                e.mainTask = "eating"
              } {
                if (gameMinutes >= 660) {
                  if (gameMinutes < 780) {
                    if (e.scheduleRole == "desk_lunch") {
                      e.mainTask = "eating"
                    }
                  }
                }
                def roll:int (random 0 99)
                if (roll < 3) {
                  if (floor.wcX >= 0) {
                    e.mainTask = "toilet"
                  } {
                    if (roll < 5) {
                      e.mainTask = "searching_item"
                    } {
                    if (roll > 96) {
                      e.mainTask = "coffee"
                    } {
                      if (e.mainTask != "eating") {
                        if (e.mainTask != "toilet") {
                          if (e.mainTask != "coffee") {
                            if (e.mainTask != "searching_item") {
                              e.mainTask = "working"
                            }
                          }
                        }
                      }
                    }
                    }
                  }
                } {
                  if (roll < 5) {
                    e.mainTask = "searching_item"
                  } {
                  if (roll > 96) {
                    e.mainTask = "coffee"
                  } {
                    if (e.mainTask != "eating") {
                      if (e.mainTask != "toilet") {
                        if (e.mainTask != "coffee") {
                          if (e.mainTask != "searching_item") {
                            e.mainTask = "working"
                          }
                        }
                      }
                    }
                  }
                  }
                }
              }
            }
          }
        }
        ei = ei + 1
      }
      fi = fi + 1
    }
  }

  fn emitGossipNearPlayer:void (speaker:MapEntity line:string) {
    def dist:int (this.manhattanTo(speaker.x speaker.y playerX playerY))
    if (dist > 8) {
      return
    }
    this.emitAmbient(speaker line)
  }

  fn countMainTaskOnFloor:int (floorIndex:int task:string) {
    def saved:int currentFloor
    currentFloor = floorIndex
    this.recomputeSize()
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def count:int 0
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.mainTask == task) {
        count = count + 1
      }
      i = i + 1
    }
    currentFloor = saved
    this.recomputeSize()
    return count
  }

  fn countMainTask:int (task:string) {
    def total:int 0
    def fi:int 0
    def fn:int (array_length floors)
    while (fi < fn) {
      total = total + (this.countMainTaskOnFloor(fi task))
      fi = fi + 1
    }
    return total
  }

  fn applyPanicFleeing:void (npcIds:[string] relations:[NpcRelation]) {
    def fi:int 0
    def fn:int (array_length floors)
    while (fi < fn) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def ei:int 0
      def en:int (array_length ents)
      while (ei < en) {
        def e:MapEntity (at ents ei)
        if ((strlen e.id) < 1) {
          ei = ei + 1
          continue
        }
        def idx:int -1
        def ri:int 0
        def rn:int (array_length npcIds)
        while (ri < rn) {
          if ((at npcIds ri) == e.id) {
            idx = ri
            break
          }
          ri = ri + 1
        }
        if (idx >= 0) {
          def rel:NpcRelation (at relations idx)
          if (rel.isPanicSevere()) {
            e.mainTask = "fleeing"
          }
        }
        ei = ei + 1
      }
      fi = fi + 1
    }
  }

  fn syncNpcOverlayEmotions:void (npcIds:[string] relations:[NpcRelation]) {
    def fi:int 0
    def fn:int (array_length floors)
    while (fi < fn) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def ei:int 0
      def en:int (array_length ents)
      while (ei < en) {
        def e:MapEntity (at ents ei)
        if ((strlen e.id) < 1) {
          ei = ei + 1
          continue
        }
        def idx:int -1
        def ri:int 0
        def rn:int (array_length npcIds)
        while (ri < rn) {
          if ((at npcIds ri) == e.id) {
            idx = ri
            break
          }
          ri = ri + 1
        }
        e.overlayEmotion = "none"
        if (idx >= 0) {
          def rel:NpcRelation (at relations idx)
          if (rel.isPanicHigh()) {
            e.overlayEmotion = "panicked"
          } {
            if (rel.isAngryStrong()) {
              e.overlayEmotion = "angry"
            } {
              if (rel.isLoveStrong()) {
                e.overlayEmotion = "in_love"
              } {
                if (rel.isJealousyHigh()) {
                  e.overlayEmotion = "jealous"
                }
              }
            }
          }
        }
        ei = ei + 1
      }
      fi = fi + 1
    }
  }

  fn getView:MapView () {
    def view:MapView (new MapView)
    def floor:MapFloor (this.activeFloor())
    view.mapTitle = title
    view.floorTitle = floor.title
    this.updateCamera()
    def lines:[string]
    def vy:int 0
    while (vy < viewPortH) {
      def mapY:int (cameraY + vy)
      def line:string ""
      def vx:int 0
      while (vx < viewPortW) {
        def mapX:int (cameraX + vx)
        line = line + (this.renderChar(mapX mapY))
        vx = vx + 1
      }
      push lines line
      vy = vy + 1
    }
    view.lines = lines
    view.mapWidth = width
    view.mapHeight = height
    view.cameraX = cameraX
    view.cameraY = cameraY
    view.playerMapX = playerX
    view.playerMapY = playerY
    view.statusLine = lastStatus
    view.ambientLine = overheardMsg
    if (policeChaseActive) {
      view.hintLine = "⚠ POLIISIT TAKAA-AJAVAT! Juokse käytävää pitkin!"
    } {
      view.hintLine = "wasd | e=työkalu | h=piiloudu | i=inventaario | b=opiskelulista | t/x=työkalu | 1-9/0=hissi | ?=oppitunnit | q=lopeta"
    }
    return view
  }
}
