
Import "JSON.rgr"
Import "StoryJson.rgr"
Import "MapEntity.rgr"
Import "MapFloor.rgr"
Import "MapView.rgr"
Import "NpcRelation.rgr"
Import "WorldEvent.rgr"
Import "WorldEventLog.rgr"

class WorldMap {
  def json:StoryJson
  def root:JSONDataObject
  def mapId:string ""
  def title:string ""
  def width:int 0
  def height:int 0
  def floors:[MapFloor]
  def currentFloor:int 0
  def playerX:int 0
  def playerY:int 0
  def lastStatus:string ""
  def hasMap:boolean false
  def foundElevatorX:int 0
  def foundElevatorY:int 0
  def viewPortW:int 30
  def viewPortH:int 18
  def cameraX:int 0
  def cameraY:int 0
  def facingX:int 0
  def facingY:int 1
  def playerHidden:boolean false
  def playerAlias:string "Larry"
  def overheardMsg:string ""
  def agentHuntFlag:boolean false
  def policeChaseActive:boolean false
  def lastPickedOwner:string ""
  def droppedCardOwners:[string]
  def leaveTargetX:int 0
  def leaveTargetY:int 0
  def navStepDx:int 0
  def navStepDy:int 0
  def eventLog:WorldEventLog
  def lastBrokenTile:string ""
  def playerWasWitnessed:boolean false
  def breachFloors:[int]
  def breachXs:[int]
  def breachYs:[int]

  Constructor () {
    json = (new StoryJson)
    eventLog = (new WorldEventLog)
    def emptyFloors:[MapFloor]
    floors = emptyFloors
    def emptyOwners:[string]
    droppedCardOwners = emptyOwners
    def emptyBreachFloors:[int]
    def emptyBreachXs:[int]
    def emptyBreachYs:[int]
    breachFloors = emptyBreachFloors
    breachXs = emptyBreachXs
    breachYs = emptyBreachYs
  }

  fn activeFloor:MapFloor () {
    if ((array_length floors) < 1) {
      return (new MapFloor)
    }
    if (currentFloor < 0) {
      return (at floors 0)
    }
    if (currentFloor >= (array_length floors)) {
      return (at floors ((array_length floors) - 1))
    }
    return (at floors currentFloor)
  }

  fn isBlockedTile:boolean (ch:string) {
    if (ch == "#") {
      return true
    }
    if (ch == "|") {
      return true
    }
    if (ch == "+") {
      return true
    }
    if (ch == "%") {
      return true
    }
    if (ch == "L") {
      return true
    }
    if (ch == "+") {
      return true
    }
    return false
  }

  fn isElevatorNeighborOk:boolean (ch:string) {
    if (ch == "#") {
      return true
    }
    if (ch == ".") {
      return true
    }
    if (ch == " ") {
      return true
    }
    if (ch == ",") {
      return true
    }
    if (ch == "=") {
      return true
    }
    if (ch == "-") {
      return true
    }
    return false
  }

  fn isElevatorCell:boolean (x:int y:int) {
    return (this.isElevatorCellOnFloor(currentFloor x y))
  }

  fn isElevatorCellOnFloor:boolean (floorIndex:int x:int y:int) {
    def ch:string (this.tileAtOnFloor(floorIndex x y))
    if (ch != "E") {
      return false
    }
    def left:string (this.tileAtOnFloor(floorIndex (x - 1) y))
    def right:string (this.tileAtOnFloor(floorIndex (x + 1) y))
    if (this.isElevatorNeighborOk(left) == false) {
      return false
    }
    if (this.isElevatorNeighborOk(right) == false) {
      return false
    }
    return true
  }

  fn ensurePlayerOnWalkable:void () {
    def cur:string (this.tileAt(playerX playerY))
    if (this.isBlockedTile(cur) == false) {
      return
    }
    if (this.findElevatorOnFloor(currentFloor)) {
      def ech:string (this.tileAt(foundElevatorX foundElevatorY))
      if (this.isBlockedTile(ech) == false) {
        playerX = foundElevatorX
        playerY = foundElevatorY
        lastStatus = "Siirryit hissille — edellinen ruutu ei ollut kulkukelpoinen."
        return
      }
    }
    def floor:MapFloor (this.activeFloor())
    playerX = floor.spawnX
    playerY = floor.spawnY
    def sch:string (this.tileAt(playerX playerY))
    if (this.isBlockedTile(sch) == false) {
      lastStatus = "Heräsit kerroksen spawn-pisteellä."
      return
    }
    def rows:[string] (floor.rows)
    def y:int 0
    def h:int (array_length rows)
    while (y < h) {
      def row:string (at rows y)
      def x:int 0
      def w:int (strlen row)
      while (x < w) {
        def tile:string (substring row x (x + 1))
        if (this.isBlockedTile(tile) == false) {
          playerX = x
          playerY = y
          lastStatus = "Siirryit lähimpään vapaaseen ruutuun."
          return
        }
        x = x + 1
      }
      y = y + 1
    }
  }

  fn isBreakableTile:boolean (ch:string tool:string) {
    if (tool == "crowbar") {
      if (ch == "%") {
        return true
      }
      if (ch == "+") {
        return true
      }
      if (ch == "=") {
        return true
      }
      return false
    }
    if (tool == "shovel") {
      if (ch == "%") {
        return true
      }
      if (ch == "=") {
        return true
      }
      if (ch == "#") {
        return true
      }
      return false
    }
    if (tool == "sledgehammer") {
      if (ch == "#") {
        return true
      }
      if (ch == "%") {
        return true
      }
      if (ch == "+") {
        return true
      }
      if (ch == "=") {
        return true
      }
    }
    return false
  }

  fn setTileAt:void (x:int y:int ch:string) {
    def floor:MapFloor (this.activeFloor())
    def rows:[string] (floor.rows)
    if (y < 0) {
      return
    }
    if (y >= (array_length rows)) {
      return
    }
    def row:string (at rows y)
    def rowLen:int (strlen row)
    if (x < 0) {
      return
    }
    if (x >= rowLen) {
      return
    }
    def left:string (substring row 0 x)
    def right:string (substring row (x + 1) rowLen)
    set rows y (left + ch + right)
  }

  fn setTileOnMapFloor:void (floor:MapFloor x:int y:int ch:string) {
    def rows:[string] (floor.rows)
    if (y < 0) {
      return
    }
    if (y >= (array_length rows)) {
      return
    }
    def row:string (at rows y)
    def rowLen:int (strlen row)
    if (x < 0) {
      return
    }
    if (x >= rowLen) {
      return
    }
    def left:string (substring row 0 x)
    def right:string (substring row (x + 1) rowLen)
    set rows y (left + ch + right)
    floor.rows = rows
  }

  fn isWalkableStampTile:boolean (ch:string) {
    if (ch == ".") {
      return true
    }
    if (ch == " ") {
      return true
    }
    if (ch == ",") {
      return true
    }
    return false
  }

  fn resolveWcFromEntities:boolean (floor:MapFloor) {
    floor.wcX = -1
    floor.wcY = -1
    def ents:[MapEntity] (floor.entities)
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.char == "🚽") {
        floor.wcX = e.x
        floor.wcY = e.y
        return true
      }
      if (e.name == "WC") {
        floor.wcX = e.x
        floor.wcY = e.y
        return true
      }
      i = i + 1
    }
    return false
  }

  fn stampWcRoomAt:void (floor:MapFloor ox:int oy:int wx:int wy:int doorX:int doorY:int) {
    this.setTileOnMapFloor(floor ox oy "#")
    this.setTileOnMapFloor(floor (ox + 3) oy "#")
    this.setTileOnMapFloor(floor ox (oy + 1) "#")
    this.setTileOnMapFloor(floor ox (oy + 2) "#")
    this.setTileOnMapFloor(floor (ox + 3) (oy + 2) "#")
    def wc:MapEntity (new MapEntity)
    wc.id = ("auto-wc-" + floor.floorId)
    wc.char = "🚽"
    wc.name = "WC"
    wc.kind = "item"
    wc.x = wx
    wc.y = wy
    wc.homeX = wx
    wc.homeY = wy
    push floor.entities wc
    floor.wcX = wx
    floor.wcY = wy
    def door:MapEntity (new MapEntity)
    door.id = ("auto-wc-door-" + floor.floorId)
    door.char = "🚪"
    door.name = "Ovi"
    door.kind = "item"
    door.x = doorX
    door.y = doorY
    door.homeX = doorX
    door.homeY = doorY
    push floor.entities door
  }

  fn wcStampSiteValid:boolean (rows:[string] ox:int oy:int wx:int wy:int doorX:int doorY:int) {
    def t00:string (this.tileAtOnMapFloorRows(rows ox oy))
    def t30:string (this.tileAtOnMapFloorRows(rows (ox + 3) oy))
    def t01:string (this.tileAtOnMapFloorRows(rows ox (oy + 1)))
    def t31:string (this.tileAtOnMapFloorRows(rows (ox + 3) (oy + 1)))
    def t02:string (this.tileAtOnMapFloorRows(rows ox (oy + 2)))
    def t32:string (this.tileAtOnMapFloorRows(rows (ox + 3) (oy + 2)))
    def tw:string (this.tileAtOnMapFloorRows(rows wx wy))
    def t40:string (this.tileAtOnMapFloorRows(rows doorX doorY))
    if (this.isWalkableStampTile(t00) == false) {
      return false
    }
    if (this.isWalkableStampTile(t30) == false) {
      return false
    }
    if (this.isWalkableStampTile(t01) == false) {
      return false
    }
    if (this.isWalkableStampTile(t31) == false) {
      return false
    }
    if (this.isWalkableStampTile(t02) == false) {
      return false
    }
    if (this.isWalkableStampTile(t32) == false) {
      return false
    }
    if (this.isWalkableStampTile(tw) == false) {
      return false
    }
    if (this.isWalkableStampTile(t40) == false) {
      return false
    }
    return true
  }

  fn stampWcRoomSearch:void (floor:MapFloor) {
    def rows:[string] (floor.rows)
    def h:int (array_length rows)
    if (h < 4) {
      return
    }
    def bestDist:int 99999
    def bestOx:int -1
    def bestOy:int -1
    def oy:int 1
    while (oy < 8) {
      if ((oy + 2) >= h) {
        break
      }
      def ox:int 1
      while (ox < 20) {
        def wx:int (ox + 1)
        def wy:int (oy + 1)
        def doorX:int (ox + 4)
        def doorY:int (oy + 1)
        if (this.wcStampSiteValid(rows ox oy wx wy doorX doorY)) {
          def dist:int (this.manhattanTo(floor.spawnX floor.spawnY wx wy))
          if (dist < bestDist) {
            bestDist = dist
            bestOx = ox
            bestOy = oy
          }
        }
        ox = ox + 1
      }
      oy = oy + 1
    }
    if (bestOx >= 0) {
      def wx2:int (bestOx + 1)
      def wy2:int (bestOy + 1)
      def doorX2:int (bestOx + 4)
      def doorY2:int (bestOy + 1)
      this.stampWcRoomAt(floor bestOx bestOy wx2 wy2 doorX2 doorY2)
    }
  }

  fn ensureWcRoom:void (floor:MapFloor floorIndex:int) {
    if (this.resolveWcFromEntities(floor) == false) {
      this.stampWcRoomSearch(floor)
    }
    this.ensureWcRoute(floorIndex floor)
  }

  fn isClosedDoorTile:boolean (ch:string) {
    if (ch == "+") {
      return true
    }
    if (ch == "L") {
      return true
    }
    return false
  }

  fn openTileOnMapFloor:void (floor:MapFloor x:int y:int) {
    def ch:string (this.tileAtOnMapFloorRows(floor.rows x y))
    if (this.isClosedDoorTile(ch)) {
      this.setTileOnMapFloor(floor x y ".")
      return
    }
    if (ch == "#") {
      this.setTileOnMapFloor(floor x y ".")
    }
  }

  fn canReachTileOnFloor:boolean (floorIndex:int sx:int sy:int tx:int ty:int) {
    def saved:int currentFloor
    currentFloor = floorIndex
    this.recomputeSize()
    def probe:MapEntity (new MapEntity)
    probe.id = "wc-route-probe"
    probe.kind = "coworker"
    probe.x = sx
    probe.y = sy
    def startIdx:int (this.cellIndex(sx sy))
    def goalIdx:int (this.cellIndex(tx ty))
    if (startIdx == goalIdx) {
      currentFloor = saved
      return true
    }
    def queue:[int]
    def discCells:[int]
    def discParent:[int]
    push queue startIdx
    push discCells startIdx
    push discParent (-1)
    def head:int 0
    def found:boolean false
    while (head < (array_length queue)) {
      def cur:int (at queue head)
      head = head + 1
      if (cur == goalIdx) {
        found = true
        break
      }
      def cx:int (this.indexX(cur))
      def cy:int (this.indexY(cur))
      def dir:int 0
      while (dir < 4) {
        def tdx:int 0
        def tdy:int 0
        if (dir == 0) {
          tdx = 0
          tdy = -1
        }
        if (dir == 1) {
          tdx = 0
          tdy = 1
        }
        if (dir == 2) {
          tdx = -1
          tdy = 0
        }
        if (dir == 3) {
          tdx = 1
          tdy = 0
        }
        def nx:int (cx + tdx)
        def ny:int (cy + tdy)
        if (this.canEntityStepTo(probe nx ny true)) {
          def ni:int (this.cellIndex(nx ny))
          if (this.isDiscovered(discCells ni) == false) {
            push queue ni
            push discCells ni
            push discParent cur
          }
        }
        dir = dir + 1
      }
    }
    if (found) {
      currentFloor = saved
      return true
    }
    currentFloor = saved
    return false
  }

  fn hasWcDoorEntityNear:boolean (floor:MapFloor) {
    if (floor.wcX < 0) {
      return false
    }
    def ents:[MapEntity] (floor.entities)
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.char == "🚪") {
        def dist:int (this.manhattanTo(e.x e.y floor.wcX floor.wcY))
        if (dist <= 3) {
          return true
        }
      }
      if (e.name == "Ovi") {
        def dist2:int (this.manhattanTo(e.x e.y floor.wcX floor.wcY))
        if (dist2 <= 3) {
          return true
        }
      }
      i = i + 1
    }
    return false
  }

  fn addWcDoorEntityAt:void (floor:MapFloor x:int y:int) {
    def door:MapEntity (new MapEntity)
    door.id = ("auto-wc-door-" + floor.floorId)
    door.char = "🚪"
    door.name = "Ovi"
    door.kind = "item"
    door.x = x
    door.y = y
    door.homeX = x
    door.homeY = y
    push floor.entities door
  }

  fn ensureWcDoorEntity:void (floor:MapFloor) {
    if (this.hasWcDoorEntityNear(floor)) {
      return
    }
    if (floor.wcX < 0) {
      return
    }
    def tryX:[int]
    def tryY:[int]
    push tryX (floor.wcX + 1)
    push tryY floor.wcY
    push tryX (floor.wcX + 2)
    push tryY floor.wcY
    push tryX floor.wcX
    push tryY (floor.wcY + 1)
    push tryX floor.wcX
    push tryY (floor.wcY - 1)
    def ti:int 0
    while (ti < 4) {
      def dx:int (at tryX ti)
      def dy:int (at tryY ti)
      def tile:string (this.tileAtOnMapFloorRows(floor.rows dx dy))
      if (this.isWalkableStampTile(tile)) {
        this.addWcDoorEntityAt(floor dx dy)
        return
      }
      ti = ti + 1
    }
  }

  fn openClosedDoorsNearWc:void (floor:MapFloor) {
    if (floor.wcX < 0) {
      return
    }
    def dy:int -2
    while (dy <= 2) {
      def dx:int -2
      while (dx <= 2) {
        def tx:int (floor.wcX + dx)
        def ty:int (floor.wcY + dy)
        def ch:string (this.tileAtOnMapFloorRows(floor.rows tx ty))
        if (this.isClosedDoorTile(ch)) {
          this.setTileOnMapFloor(floor tx ty ".")
        }
        dx = dx + 1
      }
      dy = dy + 1
    }
  }

  fn punchWcWallGap:void (floor:MapFloor) {
    if (floor.wcX < 0) {
      return
    }
    def dirsX:[int]
    def dirsY:[int]
    push dirsX 1
    push dirsY 0
    push dirsX -1
    push dirsY 0
    push dirsX 0
    push dirsY 1
    push dirsX 0
    push dirsY -1
    def di:int 0
    while (di < 4) {
      def dx:int (at dirsX di)
      def dy:int (at dirsY di)
      def wallX:int (floor.wcX + dx)
      def wallY:int (floor.wcY + dy)
      def beyondX:int (floor.wcX + (dx * 2))
      def beyondY:int (floor.wcY + (dy * 2))
      def wallTile:string (this.tileAtOnMapFloorRows(floor.rows wallX wallY))
      def beyondTile:string (this.tileAtOnMapFloorRows(floor.rows beyondX beyondY))
      if (wallTile == "#") {
        if (this.isWalkableStampTile(beyondTile)) {
          this.setTileOnMapFloor(floor wallX wallY ".")
          return
        }
      }
      di = di + 1
    }
  }

  fn ensureWcRoute:void (floorIndex:int floor:MapFloor) {
    if (floor.wcX < 0) {
      return
    }
    this.openClosedDoorsNearWc(floor)
    if (this.canReachTileOnFloor(floorIndex floor.spawnX floor.spawnY floor.wcX floor.wcY)) {
      this.ensureWcDoorEntity(floor)
      return
    }
    this.punchWcWallGap(floor)
    this.openClosedDoorsNearWc(floor)
    if (this.canReachTileOnFloor(floorIndex floor.spawnX floor.spawnY floor.wcX floor.wcY)) {
      this.ensureWcDoorEntity(floor)
      return
    }
    this.punchWcWallGap(floor)
    this.openClosedDoorsNearWc(floor)
    this.ensureWcDoorEntity(floor)
  }

  fn tileAtOnMapFloorRows:string (rows:[string] x:int y:int) {
    def h:int (array_length rows)
    if (y < 0) {
      return "#"
    }
    if (y >= h) {
      return "#"
    }
    if (x < 0) {
      return "#"
    }
    def row:string (at rows y)
    def rowLen:int (strlen row)
    if (x >= rowLen) {
      return "#"
    }
    return (substring row x (x + 1))
  }

  fn findFloorIndexForEntity:int (entityId:string) {
    if ((strlen entityId) < 1) {
      return -1
    }
    def fi:int 0
    def fn:int (array_length floors)
    while (fi < fn) {
      def floor:MapFloor (at floors fi)
      def ents:[MapEntity] (floor.entities)
      def ei:int 0
      def en:int (array_length ents)
      while (ei < en) {
        def e:MapEntity (at ents ei)
        if (e.id == entityId) {
          return fi
        }
        ei = ei + 1
      }
      fi = fi + 1
    }
    return -1
  }

  fn floorForEntity:MapFloor (entityId:string) {
    def blank:MapFloor (new MapFloor)
    def idx:int (this.findFloorIndexForEntity(entityId))
    if (idx < 0) {
      return blank
    }
    return (at floors idx)
  }

  fn isNpcAtWc:boolean (ent:MapEntity floor:MapFloor) {
    if (floor.wcX < 0) {
      return false
    }
    if (ent.x == floor.wcX) {
      if (ent.y == floor.wcY) {
        return true
      }
    }
    return false
  }

  fn isNpcNearWc:boolean (ent:MapEntity floor:MapFloor) {
    if (floor.wcX < 0) {
      return false
    }
    def dist:int (this.manhattanTo(ent.x ent.y floor.wcX floor.wcY))
    if (dist <= 1) {
      return true
    }
    return false
  }

  fn floorCount:int () {
    return (array_length floors)
  }

  fn updateCamera:void () {
    def halfW:int 15
    def halfH:int 9
    cameraX = playerX - halfW
    cameraY = playerY - halfH
    if (cameraX < 0) {
      cameraX = 0
    }
    if (cameraY < 0) {
      cameraY = 0
    }
    if (cameraX + viewPortW > width) {
      cameraX = width - viewPortW
    }
    if (cameraY + viewPortH > height) {
      cameraY = height - viewPortH
    }
    if (cameraX < 0) {
      cameraX = 0
    }
    if (cameraY < 0) {
      cameraY = 0
    }
  }

  fn tileAt:string (x:int y:int) {
    return (this.tileAtOnFloor(currentFloor x y))
  }

  fn tileAtOnFloor:string (floorIndex:int x:int y:int) {
    def floor:MapFloor (at floors floorIndex)
    def rows:[string] (floor.rows)
    def h:int (array_length rows)
    if (y < 0) {
      return "#"
    }
    if (y >= h) {
      return "#"
    }
    if (x < 0) {
      return "#"
    }
    def row:string (at rows y)
    def rowLen:int (strlen row)
    if (x >= rowLen) {
      return "#"
    }
    return (substring row x (x + 1))
  }

  fn entityAt:MapEntity (x:int y:int) {
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def i:int 0
    def n:int (array_length ents)
    def fallback:MapEntity (new MapEntity)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.x == x) {
        if (e.y == y) {
          if (e.offDuty == false) {
            return e
          }
          if ((strlen fallback.id) < 1) {
            fallback = e
          }
        }
      }
      i = i + 1
    }
    return fallback
  }

  fn isOnElevator:boolean () {
    def ch:string (this.tileAt(playerX playerY))
    if (ch == "E") {
      return true
    }
    return false
  }

  fn inferKind:string (ch:string) {
    if (ch == "G") {
      return "guru"
    }
    if (ch == "o") {
      return "hostile"
    }
    if (ch == "O") {
      return "hostile"
    }
    if (ch == "M") {
      return "hostile"
    }
    return "role"
  }

  fn normalizeEntity:void (ent:MapEntity) {
    if ((strlen ent.name) < 1) {
      ent.name = ent.id
    }
    if ((strlen ent.kind) < 1) {
      ent.kind = (this.inferKind(ent.char))
    }
    if (ent.sociability <= 0) {
      ent.sociability = 50
    }
    if (ent.persistence <= 0) {
      ent.persistence = 50
    }
    if (ent.isAgent == false) {
    if (ent.kind == "coworker") {
      ent.isAgent = true
    }
    if (ent.kind == "pet") {
      ent.isAgent = true
      if ((strlen ent.moveMode) < 1) {
        ent.moveMode = "wander"
      }
    }
      if (ent.kind == "security") {
        ent.isAgent = true
      }
      if (ent.kind == "police") {
        ent.isAgent = true
      }
      if (ent.kind == "guru") {
        ent.isAgent = true
      }
      if (ent.kind == "role") {
        if ((strlen ent.moveMode) > 0) {
          ent.isAgent = true
        }
      }
    }
    if ((strlen ent.moveMode) < 1) {
      if (ent.kind == "security") {
        ent.moveMode = "seek_player"
      }
      if (ent.kind == "coworker") {
        ent.moveMode = "wander"
      }
      if (ent.kind == "police") {
        ent.moveMode = "police_chase"
      }
    }
    if ((strlen ent.scheduleRole) > 0) {
      ent.isAgent = true
      ent.moveMode = "schedule"
      if (ent.homeX < 1) {
        ent.homeX = ent.x
      }
      if (ent.homeY < 1) {
        ent.homeY = ent.y
      }
    }
  }

  fn trySpawnPoliceAt:void (x:int y:int slot:int) {
    def tile:string (this.tileAt(x y))
    if (this.isBlockedTile(tile)) {
      return
    }
    def other:MapEntity (this.entityAt(x y))
    if ((strlen other.id) > 0) {
      return
    }
    def floor:MapFloor (this.activeFloor())
    def p:MapEntity (new MapEntity)
    p.id = ("police-" + (to_string currentFloor) + "-" + (to_string slot))
    p.char = "P"
    p.name = "Poliisi"
    p.kind = "police"
    p.moveMode = "police_chase"
    p.isAgent = true
    p.persistence = 100
    p.sociability = 0
    p.x = x
    p.y = y
    def ents:[MapEntity] (floor.entities)
    push ents p
    floor.entities = ents
  }

  fn clearPoliceSquad:void () {
    policeChaseActive = false
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def kept:[MapEntity]
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.kind != "police") {
        push kept e
      }
      i = i + 1
    }
    floor.entities = kept
  }

  fn startPoliceChase:void () {
    this.clearPoliceSquad()
    policeChaseActive = true
    this.trySpawnPoliceAt((playerX + 4) playerY 0)
    this.trySpawnPoliceAt((playerX - 4) playerY 1)
    this.trySpawnPoliceAt(playerX (playerY + 4) 2)
    lastStatus = "KOLME POLIISIA SAAPUI! P musta paidassa — he jahtaavat sinua!"
  }

  fn loadFloorEntities:void (entArr:JSONArrayObject loaded:MapFloor) {
    def ei:int 0
    def en:int (array_length entArr)
    def loadedEnt:[MapEntity]
    while (ei < en) {
      def entObj:JSONDataObject (json.arrayObjectAt(entArr ei))
      def ent:MapEntity (new MapEntity)
      ent.id = (json.objFieldStr(entObj "id"))
      ent.char = (json.objFieldStr(entObj "char"))
      if ((strlen ent.char) < 1) {
        ent.char = "?"
      }
      ent.x = (json.objFieldInt(entObj "x"))
      ent.y = (json.objFieldInt(entObj "y"))
      ent.storyId = (json.objFieldStr(entObj "storyId"))
      if ((strlen ent.storyId) < 1) {
        ent.storyId = (json.objFieldStr(entObj "template"))
      }
      ent.name = (json.objFieldStr(entObj "name"))
      ent.kind = (json.objFieldStr(entObj "kind"))
      ent.itemTool = (json.objFieldStr(entObj "itemTool"))
      ent.itemOwner = (json.objFieldStr(entObj "itemOwner"))
      ent.actionId = (json.objFieldStr(entObj "actionId"))
      ent.sociability = (json.objFieldInt(entObj "sociability"))
      ent.persistence = (json.objFieldInt(entObj "persistence"))
      ent.moveMode = (json.objFieldStr(entObj "behavior"))
      ent.agentGoal = (json.objFieldStr(entObj "agenda"))
      def agentFlag:int (json.objFieldInt(entObj "isAgent"))
      if (agentFlag != 0) {
        ent.isAgent = true
      }
      ent.topic = (json.objFieldStr(entObj "topic"))
      ent.scheduleRole = (json.objFieldStr(entObj "scheduleRole"))
      ent.homeX = (json.objFieldInt(entObj "homeX"))
      ent.homeY = (json.objFieldInt(entObj "homeY"))
      ent.npcState = (json.objFieldStr(entObj "npcState"))
      def offFlag:int (json.objFieldInt(entObj "offDuty"))
      if (offFlag != 0) {
        ent.offDuty = true
      }
      ent.romanticPreference = (json.objFieldStr(entObj "romanticPreference"))
      if ((strlen ent.romanticPreference) < 1) {
        ent.romanticPreference = "any"
      }
      ent.behaviorEligible = (json.objFieldStr(entObj "behaviorEligible"))
      this.normalizeEntity(ent)
      push loadedEnt ent
      ei = ei + 1
    }
    loaded.entities = loadedEnt
  }

  fn loadFloorRows:void (rowsArr:JSONArrayObject loaded:MapFloor) {
    def rowCount:int (array_length rowsArr)
    def loadedRows:[string]
    def ri:int 0
    while (ri < rowCount) {
      def rowObj:JSONDataObject (json.arrayObjectAt(rowsArr ri))
      push loadedRows (json.objFieldStr(rowObj "line"))
      ri = ri + 1
    }
    loaded.rows = loadedRows
  }

  fn loadSingleFloor:void (floorObj:JSONDataObject loaded:MapFloor) {
    loaded.floorId = (json.objFieldStr(floorObj "id"))
    loaded.title = (json.objFieldStr(floorObj "title"))
    def rowsOpt@(optional):JSONArrayObject (getArray floorObj "rows")
    if ((null? rowsOpt) == false) {
      this.loadFloorRows((unwrap rowsOpt) loaded)
    }
    def entOpt@(optional):JSONArrayObject (getArray floorObj "entities")
    if ((null? entOpt) == false) {
      this.loadFloorEntities((unwrap entOpt) loaded)
    }
    def spawnObj@(optional):JSONDataObject (getObject floorObj "spawn")
    if ((null? spawnObj) == false) {
      def spawn:JSONDataObject (unwrap spawnObj)
      loaded.spawnX = (json.objFieldInt(spawn "x"))
      loaded.spawnY = (json.objFieldInt(spawn "y"))
    }
    def cafObj@(optional):JSONDataObject (getObject floorObj "cafeteria")
    if ((null? cafObj) == false) {
      def caf:JSONDataObject (unwrap cafObj)
      loaded.cafeteriaX = (json.objFieldInt(caf "x"))
      loaded.cafeteriaY = (json.objFieldInt(caf "y"))
    }
    def doorObj@(optional):JSONDataObject (getObject floorObj "door")
    if ((null? doorObj) == false) {
      def door:JSONDataObject (unwrap doorObj)
      loaded.doorX = (json.objFieldInt(door "x"))
      loaded.doorY = (json.objFieldInt(door "y"))
    }
  }

  fn recomputeSize:void () {
    def floor:MapFloor (this.activeFloor())
    def rows:[string] (floor.rows)
    def rowCount:int (array_length rows)
    height = rowCount
    if (rowCount < 1) {
      width = 0
      return
    }
    def w:int 0
    def wi:int 0
    while (wi < rowCount) {
      def len:int (strlen (at rows wi))
      if (len > w) {
        w = len
      }
      wi = wi + 1
    }
    width = w
  }

  fn loadFromText:boolean (mapJson:string) {
    try {
      def rootOpt@(optional):JSONDataObject (from_string mapJson)
      if (null? rootOpt) {
        hasMap = false
        return false
      }
      root = (unwrap rootOpt)
    } {
      hasMap = false
      return false
    }
    mapId = (json.objFieldStr((unwrap root) "id"))
    title = (json.objFieldStr((unwrap root) "title"))
    currentFloor = (json.objFieldInt((unwrap root) "startFloor"))

    def floorsOpt@(optional):JSONArrayObject (getArray (unwrap root) "floors")
    if (null? floorsOpt) {
      hasMap = false
      return false
    }
    def floorsArr:JSONArrayObject (unwrap floorsOpt)
    def floorCount:int (array_length floorsArr)
    if (floorCount < 1) {
      hasMap = false
      return false
    }

    def loadedFloors:[MapFloor]
    def fi:int 0
    while (fi < floorCount) {
      def floorObj:JSONDataObject (json.arrayObjectAt(floorsArr fi))
      def floor:MapFloor (new MapFloor)
      this.loadSingleFloor(floorObj floor)
      this.ensureWcRoom(floor fi)
      this.snapshotOriginalRows(floor)
      push loadedFloors floor
      fi = fi + 1
    }
    floors = loadedFloors

    def start:MapFloor (this.activeFloor())
    playerX = start.spawnX
    playerY = start.spawnY
    playerAlias = (json.objFieldStr((unwrap root) "playerAlias"))
    if ((strlen playerAlias) < 1) {
      playerAlias = "Larry"
    }
    playerHidden = false
    overheardMsg = ""
    this.recomputeSize()
    this.ensurePlayerOnWalkable()
    lastStatus = ""
    hasMap = true
    return true
  }

  fn findElevatorOnFloor:boolean (floorIndex:int) {
    return (this.findElevatorAt(floorIndex))
  }

  fn findElevatorAt:boolean (floorIndex:int) {
    def floor:MapFloor (at floors floorIndex)
    def rows:[string] (floor.rows)
    def y:int 0
    def h:int (array_length rows)
    while (y < h) {
      def row:string (at rows y)
      def x:int 0
      def w:int (strlen row)
      while (x < w) {
        def ch:string (substring row x (x + 1))
        if (ch == "E") {
          if (this.isElevatorCellOnFloor(floorIndex x y)) {
            foundElevatorX = x
            foundElevatorY = y
            return true
          }
        }
        x = x + 1
      }
      y = y + 1
    }
    return false
  }

  fn tryElevatorTo:boolean (targetFloor:int) {
    if (hasMap == false) {
      return false
    }
    if (this.isOnElevator() == false) {
      lastStatus = "Hissi on vain E-ruudulla."
      return false
    }
    def floorCount:int (array_length floors)
    if (targetFloor < 0) {
      return false
    }
    if (targetFloor >= floorCount) {
      lastStatus = "Kerrosta ei ole."
      return false
    }
    if (targetFloor == currentFloor) {
      lastStatus = "Olet jo tällä kerroksella."
      return false
    }
    if (this.findElevatorOnFloor(targetFloor) == false) {
      lastStatus = "Hissiä ei ole kohdekerroksessa."
      return false
    }
    currentFloor = targetFloor
    playerX = foundElevatorX
    playerY = foundElevatorY
    this.recomputeSize()
    this.ensurePlayerOnWalkable()
    def floor:MapFloor (this.activeFloor())
    lastStatus = ("Hissi: " + floor.title)
    return true
  }

  fn floorMapWidth:int (floorIndex:int) {
    def floor:MapFloor (at floors floorIndex)
    def rows:[string] (floor.rows)
    def h:int (array_length rows)
    if (h < 1) {
      return 0
    }
    return (strlen (at rows 0))
  }

  fn floorMapHeight:int (floorIndex:int) {
    def floor:MapFloor (at floors floorIndex)
    def rows:[string] (floor.rows)
    return (array_length rows)
  }

  fn isMapEdgeCell:boolean (floorIndex:int x:int y:int) {
    def w:int (this.floorMapWidth(floorIndex))
    def h:int (this.floorMapHeight(floorIndex))
    if (w < 1) {
      return false
    }
    if (h < 1) {
      return false
    }
    if (x == 0) {
      return true
    }
    if (y == 0) {
      return true
    }
    if (x == (w - 1)) {
      return true
    }
    if (y == (h - 1)) {
      return true
    }
    return false
  }

  fn isOuterWallCell:boolean (floorIndex:int x:int y:int) {
    if (floorIndex < 1) {
      return false
    }
    if (this.isMapEdgeCell(floorIndex x y) == false) {
      return false
    }
    def tile:string (this.tileAtOnFloor(floorIndex x y))
    if (tile == "#") {
      return true
    }
    return false
  }

  fn recordOuterWallBreach:void (x:int y:int) {
    def i:int 0
    def n:int (array_length breachFloors)
    while (i < n) {
      if ((at breachFloors i) == currentFloor) {
        if ((at breachXs i) == x) {
          if ((at breachYs i) == y) {
            return
          }
        }
      }
      i = i + 1
    }
    push breachFloors currentFloor
    push breachXs x
    push breachYs y
  }

  fn hasOuterWallBreach:boolean (x:int y:int) {
    def i:int 0
    def n:int (array_length breachFloors)
    while (i < n) {
      if ((at breachFloors i) == currentFloor) {
        if ((at breachXs i) == x) {
          if ((at breachYs i) == y) {
            return true
          }
        }
      }
      i = i + 1
    }
    return false
  }

  fn clearOuterWallBreaches:void () {
    def emptyFloors:[int]
    def emptyXs:[int]
    def emptyYs:[int]
    breachFloors = emptyFloors
    breachXs = emptyXs
    breachYs = emptyYs
  }

  fn hasAnyOuterWallBreach:boolean () {
    if ((array_length breachFloors) > 0) {
      return true
    }
    return false
  }

  fn canPlaceDroppedItem:boolean (x:int y:int) {
    def tile:string (this.tileAt(x y))
    if (this.isBlockedTile(tile)) {
      return false
    }
    def e:MapEntity (this.entityAt(x y))
    if ((strlen e.id) > 0) {
      return false
    }
    return true
  }

  fn itemCharForTool:string (toolId:string) {
    if (toolId == "crowbar") {
      return "("
    }
    if (toolId == "sledgehammer") {
      return "T"
    }
    if (toolId == "shovel") {
      return "/"
    }
    if (toolId == "access_card") {
      return "k"
    }
    if (toolId == "coworker_card") {
      return "k"
    }
    if (toolId == "promoted_card") {
      return "k"
    }
    if (toolId == "official_badge") {
      return "k"
    }
    if (toolId == "shed_key") {
      return "a"
    }
    if (toolId == "usb_drive") {
      return "u"
    }
    return "*"
  }

  fn itemNameForTool:string (toolId:string) {
    if (toolId == "access_card") {
      return "kadonnut kulkukortti"
    }
    if (toolId == "coworker_card") {
      return "löydetty kulkukortti"
    }
    if (toolId == "official_badge") {
      return "virallinen kulkulupa"
    }
    if (toolId == "promoted_card") {
      return "ylennyskortti"
    }
    if (toolId == "shed_key") {
      return "vajan avain"
    }
    if (toolId == "usb_drive") {
      return "USB-tikku"
    }
    if (toolId == "crowbar") {
      return "vasara"
    }
    if (toolId == "shovel") {
      return "lapio"
    }
    if (toolId == "sledgehammer") {
      return "kivivasara"
    }
    return "esine"
  }

  fn dropItemAt:boolean (x:int y:int toolId:string ownerId:string) {
    if (this.canPlaceDroppedItem(x y) == false) {
      return false
    }
    def floor:MapFloor (this.activeFloor())
    def item:MapEntity (new MapEntity)
    item.id = ("dropped-" + toolId + "-" + (to_string x) + "-" + (to_string y))
    item.char = (this.itemCharForTool(toolId))
    item.name = (this.itemNameForTool(toolId))
    item.kind = "item"
    item.itemTool = toolId
    item.itemOwner = ownerId
    item.x = x
    item.y = y
    def ents:[MapEntity] (floor.entities)
    push ents item
    floor.entities = ents
    return true
  }

  fn findNearestAgent:MapEntity (kind:string) {
    def best:MapEntity (new MapEntity)
    def bestDist:int 999
    def floor:MapFloor (this.activeFloor())
    def ents:[MapEntity] (floor.entities)
    def i:int 0
    def n:int (array_length ents)
    while (i < n) {
      def e:MapEntity (at ents i)
      if (e.kind != kind) {
        i = i + 1
        continue
      }
      def dx:int (e.x - playerX)
      if (dx < 0) {
        dx = (0 - dx)
      }
      def dy:int (e.y - playerY)
      if (dy < 0) {
        dy = (0 - dy)
      }
      def dist:int (dx + dy)
      if (dist < bestDist) {
        bestDist = dist
        best = e
      }
      i = i + 1
    }
    return best
  }

  fn copyRows:[string] (src:[string]) {
    def out:[string]
    def i:int 0
    def n:int (array_length src)
    while (i < n) {
      push out (at src i)
      i = i + 1
    }
    return out
  }

  fn snapshotOriginalRows:void (floor:MapFloor) {
    floor.originalRows = (this.copyRows(floor.rows))
  }

  fn restoreMapTiles:void () {
    def i:int 0
    def n:int (array_length floors)
    while (i < n) {
      def floor:MapFloor (at floors i)
      if ((array_length floor.originalRows) > 0) {
        floor.rows = (this.copyRows(floor.originalRows))
      }
      i = i + 1
    }
    eventLog.reset()
    this.clearOuterWallBreaches()
    this.recomputeSize()
  }

  fn wouldExitBuilding:boolean (dx:int dy:int) {
    if (currentFloor < 1) {
      return false
    }
    if (this.hasOuterWallBreach(playerX playerY) == false) {
      return false
    }
    def nx:int (playerX + dx)
    def ny:int (playerY + dy)
    def w:int (this.floorMapWidth(currentFloor))
    def h:int (this.floorMapHeight(currentFloor))
    if (w < 1) {
      return false
    }
    if (h < 1) {
      return false
    }
    if (nx < 0) {
      if (playerX == 0) {
        return true
      }
    }
    if (ny < 0) {
      if (playerY == 0) {
        return true
      }
    }
    if (nx >= w) {
      if (playerX == (w - 1)) {
        return true
      }
    }
    if (ny >= h) {
      if (playerY == (h - 1)) {
        return true
      }
    }
    return false
  }

  fn tryMove:boolean (dx:int dy:int) {
    if (hasMap == false) {
      return false
    }
    if (dx != 0) {
      facingX = dx
      facingY = 0
    }
    if (dy != 0) {
      facingX = 0
      facingY = dy
    }
    def nx:int (playerX + dx)
    def ny:int (playerY + dy)
    def tile:string (this.tileAt(nx ny))
    if (this.isBlockedTile(tile)) {
      lastStatus = "Este — tarvitset ehkä työkalun (x)."
      return false
    }
    def blocker:MapEntity (this.entityAt(nx ny))
    if (this.entityBlocksPlayer(blocker)) {
      lastStatus = "Tiellä on joku."
      return false
    }
    playerHidden = false
    playerX = nx
    playerY = ny
    if (this.isOnElevator()) {
      lastStatus = "Hissi — 1-9/0 vaihtaa kerrosta."
    }
    return true
  }

  fn emojiStepMessage:string (x:int y:int) {
    def e:MapEntity (this.entityAt(x y))
    if ((strlen e.id) < 1) {
      return ""
    }
    return (this.emojiFeelingForEntity(e))
  }

